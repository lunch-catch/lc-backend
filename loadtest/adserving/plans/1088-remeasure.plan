# #1088 재측정의 측정 계획이다. 순서와 조건은 #1088 의 측정 절이 정한다. 돌리는 법은 loadtest/README.md 의 측정 계획 절이 갖는다.
# 한 줄에 버전 하나: <버전 이름> <커밋, 태그나 SHA> [ref=<LOADTEST_REF>] [version 의 선택지...]
#
# 커밋: v1 ~ v3c 는 측정용 공통 관측 코드를 덧붙인 -obs 태그다(#1302). serving-v1, v2 는 같은 커밋인 v3b, v3c 의 -obs 를 쓴다.
#       v4 와 serving-v3 은 연결 풀을 켠 develop 커밋이고, 측정 직전에 정해 TBD 를 바꾼다(#1088).
# ref: 예전 태그에는 loadtest/adserving/ 과 피드만 보내는 시나리오가 없어 develop 에서 받는다(#1088).
# 시간 제한: 예전 이미지는 예전 값을 갖고 있어 #1217 이 정한 값을 앱과 배치에 따로 넣는다. 대소문자를 지키려고 SPRING_APPLICATION_JSON 으로 넘긴다.
#           v4 와 serving-v3 의 develop 이미지에는 이미 들어 있다.

v1 adserving-impression-v1-obs ref=develop --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
v2 adserving-impression-v2-obs ref=develop --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
v3 adserving-impression-v3-obs ref=develop --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
v3b adserving-impression-v3b-obs ref=develop --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
serving-v1 adserving-impression-v3b-obs ref=develop --scenario feed --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
v3c adserving-impression-v3c-obs ref=develop --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
serving-v2 adserving-impression-v3c-obs ref=develop --scenario feed --app-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":10000,"spring.jpa.properties.jakarta.persistence.query.timeout":5000,"spring.jdbc.template.query-timeout":"5s","spring.transaction.default-timeout":"5s"} --batch-env SPRING_APPLICATION_JSON={"spring.datasource.hikari.data-source-properties.socketTimeout":300000,"spring.jpa.properties.jakarta.persistence.query.timeout":120000,"spring.jdbc.template.query-timeout":"2m","spring.transaction.default-timeout":"-1s"}
v4 TBD
serving-v3 TBD --scenario feed
serving-v3-nopool TBD --scenario feed --no-pool
